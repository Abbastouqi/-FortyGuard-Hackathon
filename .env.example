# FortyGuard trial key — from the Profile tab in dashboard.fortyguard.com
FORTYGUARD_API_KEY=your-fortyguard-key-here

# --- LLM backend: set EITHER the OpenAI-compatible gateway below OR an Anthropic key ---

# Option A: any OpenAI-compatible endpoint (vLLM / LiteLLM / self-hosted gateway).
# Tool calls are done via a prompt-based JSON protocol, so native tool-calling
# support is NOT required.
#HEATOPS_LLM_BASE_URL=https://your-gateway.example.com/api/v1
#HEATOPS_LLM_API_KEY=your-gateway-key-here
#HEATOPS_LLM_VERIFY_TLS=true   # set false only for self-signed certs
#HEATOPS_MODEL=qwen3.6-35b-a3b

# Option B: Anthropic API with native tool use (console.anthropic.com).
# Used when HEATOPS_LLM_BASE_URL is unset.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
#HEATOPS_MODEL=claude-sonnet-4-6
